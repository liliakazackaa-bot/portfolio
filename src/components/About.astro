---
import { Image } from 'astro:assets';
import { site } from '../content/site';
import SectionLabel from './SectionLabel.astro';
import photo from '../assets/photo.png';
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionLabel num="04" text="обо мне" />
    <div class="about">
      <figure class="about__photo reveal">
        <Image src={photo} alt={`${site.name} за ноутбуком вместе с роботом-помощником: сайты, приложения, ИИ-агенты`} widths={[420, 840]} sizes="(min-width: 900px) 420px, 100vw" loading="lazy" quality={80} />
        <figcaption class="mono dim">photo.jpg</figcaption>
      </figure>
      <div class="about__text">
        <h2 id="about-title" class="reveal">Обо мне</h2>
        {site.about.map((p) => <p class="reveal">{p}</p>)}
        <ul class="about__stack reveal" data-stack aria-label="Стек">
          {site.stack.map((s) => <li class="tag">{s}</li>)}
        </ul>
        <p class="about__links mono reveal">
          <a href={site.github} target="_blank" rel="noopener">github ↗</a>
          <a href={site.telegramUrl} target="_blank" rel="noopener">telegram ↗</a>
          <a href={`mailto:${site.email}`}>email ↗</a>
        </p>
      </div>
    </div>

    <ul class="stats" data-stats aria-label="Коротко в цифрах">
      {site.stats.map((s) => (
        <li class="stat" data-counter>
          <p class="stat__num">
            {s.prefix && <span class="stat__suffix">{s.prefix}</span>}
            {s.animate === false ? <span>{s.value}</span> : <span data-count-value data-count-to={s.value}>{s.value}</span>}<span class="stat__suffix">{s.suffix}</span>
          </p>
          <p class="stat__label mono dim">{s.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--s7);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
  .about__photo {
    position: relative;
    margin: 0;
    max-width: 420px;
    padding: 10px;
    --c: var(--lime);
    background:
      linear-gradient(var(--c), var(--c)) top left / 18px 2px,
      linear-gradient(var(--c), var(--c)) top left / 2px 18px,
      linear-gradient(var(--c), var(--c)) bottom right / 18px 2px,
      linear-gradient(var(--c), var(--c)) bottom right / 2px 18px;
    background-repeat: no-repeat;
  }
  .about__photo :global(img) {
    width: 100%;
    aspect-ratio: 1169 / 1345;
    object-fit: cover;
    object-position: 50% 30%;
    border: 1px solid var(--line);
  }
  .about__photo figcaption {
    margin-top: var(--s2);
    font-size: 0.75rem;
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }
  .about__text > p {
    font-size: 1.1875rem;
    max-width: 56ch;
  }
  .about__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about__stack .tag {
    border-color: color-mix(in oklch, var(--cyan), transparent 60%);
    color: var(--text);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--s4);
    margin: var(--s8) 0 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    padding: var(--s5);
    border-top: 2px solid var(--lime);
    background: var(--surface);
  }
  .stat__num {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--lime);
  }
  .stat__suffix {
    font-size: 0.5em;
    font-weight: 700;
    color: var(--text);
  }
  .stat__label {
    margin-top: var(--s3);
    font-size: var(--fs-small);
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
  }
</style>

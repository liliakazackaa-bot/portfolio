---
import { site } from '../content/site';

const h1 = 'Собираю сайты, приложения и ИИ-агентов';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="hero__status mono" data-hero-status>
      <span class="dim">~/portfolio $ status</span><br />
      <span><span class="dot" aria-hidden="true"></span>→ available: {site.availableFrom}</span>
    </p>

    <h1 class="hero__title" id="hero-title" aria-label={h1} data-typewriter><span aria-hidden="true" data-type-text>Собираю сайты, приложения и <span class="mark">ИИ-агентов</span></span><span class="cursor" aria-hidden="true">▊</span></h1>

    <p class="hero__for mono dim">для экспертов и бизнеса_</p>
    <p class="hero__sub">
      Беру задачу целиком: от идеи и дизайна до запуска и поддержки. Первая версия — от 2 недель.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">[ обсудить проект ]</a>
      <a class="btn btn--secondary" href="#work">смотреть проекты ↓</a>
    </div>
    <p class="hero__trust mono dim">отвечаю в течение дня · работаю по договору · код и доступы — ваши</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 10vw, 7rem) var(--section-gap);
    overflow: hidden;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--line) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }
  .hero__status {
    font-size: var(--fs-mono);
    line-height: 1.7;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--lime);
    vertical-align: middle;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 1.6s ease-out infinite;
    }
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--lime), transparent 40%);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .hero__title {
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .hero__title :global(.mark) {
    padding: 0 0.1em;
    background: linear-gradient(var(--lime), var(--lime)) 0 75% / 100% 78% no-repeat;
  }
  .hero__title > .cursor {
    margin-left: 0.12em;
  }
  .hero__for {
    font-size: 1rem;
    margin-top: calc(-1 * var(--s3));
  }
  .hero__sub {
    max-width: 52ch;
    font-size: 1.1875rem;
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s2);
  }
  .hero__trust {
    font-size: var(--fs-small);
  }

  :global(.ch.is-pending) {
    visibility: hidden;
  }
  @property --wght {
    syntax: '<number>';
    inherits: true;
    initial-value: 800;
  }
  @media (hover: hover) and (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    :global(.hero__title .w) {
      font-variation-settings: 'wght' var(--wght);
      transition: --wght 0.4s;
    }
    :global(.hero__title .w:hover) {
      --wght: 900;
    }
  }
</style>

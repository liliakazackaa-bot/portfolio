---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import MobileCta from '../components/MobileCta.astro';
import { pageTitle, pageDescription } from '../content/site';
import { buildJsonLd } from '../content/schema';
---
<Base title={pageTitle} description={pageDescription} jsonLd={buildJsonLd()}>
  <Header slot="header" />
  <Hero />
  <Services />
  <Work />
  <Process />
  <About />
  <Faq />
  <Contact />
  <MobileCta />
</Base>

<script>
  import '../scripts/main';
</script>
